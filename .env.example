# ---- Django -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,dashboard.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://dashboard.example.com
DJANGO_LOG_LEVEL=INFO

# ---- Database -----------------------------------------------------------
# When POSTGRES_DB and POSTGRES_HOST are set the project uses PostgreSQL,
# otherwise it falls back to a local SQLite file (development only).
POSTGRES_DB=factory
POSTGRES_USER=factory
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# ---- Redis / Celery -----------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
USE_REDIS_CACHE=True
# Set to True to run Celery tasks in-process (handy without a broker).
CELERY_TASK_ALWAYS_EAGER=False
THRESHOLD_EVALUATION_SECONDS=60

# ---- Email --------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=dashboard@example.com
ALERTS_FROM_EMAIL=dashboard@example.com
# Comma separated - these always receive an alert mail.
ALERTS_RECIPIENTS=manager@example.com
ALERTS_DASHBOARD_URL=https://dashboard.example.com/alerts/

# ---- Localisation -------------------------------------------------------
DJANGO_LANGUAGE_CODE=en
TIME_ZONE=Africa/Cairo
# LANGUAGES are defined in settings.py (en, ar).

# ---- Dashboard ----------------------------------------------------------
# Planned production minutes per shift, used for the OEE availability.
PLANNED_SHIFT_MINUTES=480
# How often the dashboard polls for new numbers (seconds).
DASHBOARD_REFRESH_SECONDS=45

# ---- Security -----------------------------------------------------------
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=True

# ---- Gunicorn -----------------------------------------------------------
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_LOG_LEVEL=info

# ---- CORS (only if a separate frontend calls the API) ------------------
CORS_ALLOWED_ORIGINS=https://frontend.example.com
